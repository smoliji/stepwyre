{
  "name": "node-harness",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "harness": "dist/harness.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --platform=node --format=esm --target=node22 --jsx=automatic --packages=external --outfile=dist/harness.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "harness": "node dist/harness.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
