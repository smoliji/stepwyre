{
  // VS Code debug config for the harness CLI.
  // Run 'pnpm build' first so dist/harness.js exists before launching this.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Development",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/dist/harness.js",
      "args": ["${workspaceFolder}/examples/harness.yaml"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
